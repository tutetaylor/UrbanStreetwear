<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Urban Streetwear — Paleta Bandera Argentina</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles-palette-1-bandera-argentina.css">
</head>
<body>

<div id="cursor"></div>
<div class="palette-badge">Paleta 01 — Bandera Argentina</div>


<header>
  <nav class="nav-left">
    <a href="#catalogo">Colecciones</a>
    <a href="#lookbook">Drops</a>
    <a href="#footer">Info</a>
  </nav>
  <a href="index.html" class="logo">URBAN<span>°</span>STREETWEAR</a>
  <div class="nav-right">
    <button class="icon-btn" id="currency-toggle" type="button" aria-label="Cambiar moneda">ARS $</button>
    <button class="icon-btn" id="search-toggle" type="button" aria-label="Buscar">🔍</button>
    <button class="icon-btn" id="cart-toggle" type="button" aria-label="Ver carrito">🛒 <span class="cart-count">0</span></button>
  </div>
</header>

<section class="hero">
  <div class="marquee-track">
    <div class="marquee-anim">
      <span>NUEVA COLECCIÓN // DROP 01 // FREE SHIPPING // NUEVA COLECCIÓN // DROP 01 // FREE SHIPPING //</span>
      <span>NUEVA COLECCIÓN // DROP 01 // FREE SHIPPING // NUEVA COLECCIÓN // DROP 01 // FREE SHIPPING //</span>
    </div>
  </div>

  <div class="hero-content">
    <span class="eyebrow">Otoño / Invierno — Edición 04</span>
    <div class="hero-image-wrap">
      <img class="hero-image" src="https://picsum.photos/seed/urban-hero/800/1000" alt="Imagen de prueba — modelo con hoodie oversize de la colección">
      <span class="drop-tag">DROP 01</span>
    </div>
    <h1 class="hero-title">Ropa que no pide permiso</h1>
    <p class="hero-sub">Cortes oversize, telas pesadas y una paleta que no negocia. Stock limitado por prenda.</p>
    <a href="#catalogo" class="cta">EXPLORAR DROP
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>

<section id="catalogo">
  <div class="section-head">
    <h2>Catálogo</h2>
    <span class="tag">04 PRENDAS — DROP 01</span>
  </div>

  <div class="grid">

    <div class="card" data-id="hoodie-04">
      <div class="card-img-wrap">
        <span class="badge limited">Edición limitada</span>
        <img class="img-front" src="https://picsum.photos/seed/hoodie-front/600/800" alt="Imagen de prueba — hoodie oversize, vista frontal">
        <img class="img-back" src="https://picsum.photos/seed/hoodie-back/600/800" alt="Imagen de prueba — textura de la tela">
      </div>
      <div class="card-label">
        [ HOODIE OVERSIZE #04 ]<span class="name">100% ALGODÓN HEAVYWEIGHT</span>
        <span class="price" data-price-ars="45000">$45.000</span>
      </div>
      <button class="add-to-cart" data-id="hoodie-04" type="button">+ Agregar al carrito</button>
    </div>

    <div class="card" data-id="cargo-07">
      <div class="card-img-wrap">
        <img class="img-front" src="https://picsum.photos/seed/cargo-front/600/800" alt="Imagen de prueba — pantalón cargo, vista frontal">
        <img class="img-back" src="https://picsum.photos/seed/cargo-back/600/800" alt="Imagen de prueba — detalle de bolsillos">
      </div>
      <div class="card-label">
        [ CARGO TÉCNICO #07 ]<span class="name">NYLON RIPSTOP RESISTENTE</span>
        <span class="price" data-price-ars="52000">$52.000</span>
      </div>
      <button class="add-to-cart" data-id="cargo-07" type="button">+ Agregar al carrito</button>
    </div>

    <div class="card" data-id="bomber-02">
      <div class="card-img-wrap">
        <span class="badge soldout">Agotado</span>
        <img class="img-front" src="https://picsum.photos/seed/bomber-front/600/800" alt="Imagen de prueba — campera bomber, vista frontal">
        <img class="img-back" src="https://picsum.photos/seed/bomber-back/600/800" alt="Imagen de prueba — detalle de forro">
      </div>
      <div class="card-label">
        [ BOMBER STREET #02 ]<span class="name">SHELL IMPERMEABLE</span>
        <span class="price" data-price-ars="68000">$68.000</span>
      </div>
      <button class="add-to-cart" data-id="bomber-02" type="button" disabled>Agotado</button>
    </div>

    <div class="card" data-id="tee-11">
      <div class="card-img-wrap">
        <img class="img-front" src="https://picsum.photos/seed/tee-front/600/800" alt="Imagen de prueba — remera gráfica, vista frontal">
        <img class="img-back" src="https://picsum.photos/seed/tee-back/600/800" alt="Imagen de prueba — estampado trasero">
      </div>
      <div class="card-label">
        [ TEE GRÁFICA #11 ]<span class="name">JERSEY 240GSM</span>
        <span class="price" data-price-ars="28000">$28.000</span>
      </div>
      <button class="add-to-cart" data-id="tee-11" type="button">+ Agregar al carrito</button>
    </div>

  </div>
</section>

<section id="lookbook">
  <div class="section-head">
    <h2>Lookbook</h2>
    <div class="head-actions">
      <span class="tag">DESLIZÁ PARA VER MÁS →</span>
      <div class="lookbook-nav">
        <button id="look-prev" type="button" aria-label="Look anterior">←</button>
        <button id="look-next" type="button" aria-label="Look siguiente">→</button>
      </div>
    </div>
  </div>

  <div class="lookbook-scroll" id="lookbook-scroll">

    <div class="look">
      <img src="https://picsum.photos/seed/look-01/700/933" alt="Imagen de prueba — outfit completo look urbano 1">
      <div class="look-dot" style="top:38%;left:52%;">+</div>
      <div class="shop-card">
        <span>HOODIE OVERSIZE #04</span>
        <button class="buy" data-id="hoodie-04" type="button">Comprar</button>
      </div>
    </div>

    <div class="look">
      <img src="https://picsum.photos/seed/look-02/700/933" alt="Imagen de prueba — outfit completo look urbano 2">
      <div class="look-dot" style="top:55%;left:40%;">+</div>
      <div class="shop-card">
        <span>CARGO TÉCNICO #07</span>
        <button class="buy" data-id="cargo-07" type="button">Comprar</button>
      </div>
    </div>

    <div class="look">
      <img src="https://picsum.photos/seed/look-03/700/933" alt="Imagen de prueba — outfit completo look urbano 3">
      <div class="look-dot" style="top:30%;left:60%;">+</div>
      <div class="shop-card">
        <span>BOMBER STREET #02</span>
        <button class="buy" data-id="bomber-02" type="button" disabled>Agotado</button>
      </div>
    </div>

    <div class="look">
      <img src="https://picsum.photos/seed/look-04/700/933" alt="Imagen de prueba — outfit completo look urbano 4">
      <div class="look-dot" style="top:44%;left:48%;">+</div>
      <div class="shop-card">
        <span>TEE GRÁFICA #11</span>
        <button class="buy" data-id="tee-11" type="button">Comprar</button>
      </div>
    </div>

  </div>
</section>

<footer id="footer">
  <div class="footer-top">
    <div class="footer-links">
      <div class="footer-col">
        <h4>Tienda</h4>
        <a href="#catalogo">Colecciones</a>
        <a href="#lookbook">Lookbook</a>
        <a href="drops-anteriores.html">Drops anteriores</a>
      </div>
      <div class="footer-col">
        <h4>Ayuda</h4>
        <a href="envios.html">Envíos</a>
        <a href="cambios-devoluciones.html">Cambios y devoluciones</a>
        <a href="guia-talles.html">Guía de talles</a>
      </div>
      <div class="footer-col">
        <h4>Marca</h4>
        <a href="nosotros.html">Nosotros</a>
        <a href="https://instagram.com/urbanstreetwear" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="contacto.html">Contacto</a>
      </div>
    </div>

    <div class="newsletter">
      <h4>Newsletter</h4>
      <form class="newsletter-form">
        <input type="email" placeholder="Unete al club" required>
        <button type="submit" aria-label="Suscribirse">→</button>
      </form>
      <span class="newsletter-note">¡Listo! Ya sos parte del club — mirá tu correo.</span>
    </div>
  </div>

  <div class="brand-line">URBAN STREETWEAR</div>

  <div class="footer-bottom">
    <span>© 2026 URBAN STREETWEAR — TODOS LOS DERECHOS RESERVADOS</span>
    <span>BUENOS AIRES, ARG</span>
  </div>
</footer>

<div class="search-overlay" id="search-overlay">
  <div class="search-box">
    <span class="search-icon">🔍</span>
    <input type="text" id="search-input" placeholder="Buscar prendas — hoodie, cargo, bomber, tee…" autocomplete="off">
    <button class="search-close" id="search-close" type="button" aria-label="Cerrar búsqueda">✕</button>
  </div>
  <div class="search-results" id="search-results">
    <p class="search-hint">Empezá a escribir para ver resultados del catálogo.</p>
  </div>
</div>

<div class="cart-overlay" id="cart-overlay"></div>
<aside class="cart-drawer" id="cart-drawer" aria-hidden="true">
  <div class="cart-drawer-head">
    <h3>Tu carrito</h3>
    <button class="cart-close" id="cart-close" type="button" aria-label="Cerrar carrito">✕</button>
  </div>
  <div class="cart-items" id="cart-items"></div>
  <div class="cart-footer">
    <div class="cart-subtotal"><span>Subtotal</span><span id="cart-subtotal">$0</span></div>
    <button class="cta cart-checkout" id="cart-checkout" type="button" disabled>FINALIZAR COMPRA</button>
    <span class="cart-note" id="cart-note">¡Listo! Pedido confirmado — te llega un mail con el resumen.</span>
  </div>
</aside>

<div class="toast" id="toast"></div>

<script src="script.js"></script>

</body>
</html>
